# Server settings
PORT=8081
NODE_ENV=development
LOG_LEVEL=info

# Upload settings
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=16777216  # 16MB in bytes

# LLM settings
# Note: Hugging Face models are limited to ~4096 total tokens (input + output)
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here
LLM_MODEL="ibm-granite/granite-3.2-8b-instruct"
LLM_TEMPERATURE=0.7
LLM_MAX_LENGTH=2048

# Local model settings (Ollama)
# Using a local model allows for much larger context windows
USE_LOCAL_MODEL=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite
OLLAMA_CONTEXT_WINDOW=16384  # 16k context window
