FROM node:20-slim

WORKDIR /app

# Install required system libraries for ARM64
RUN apt-get update && apt-get install -y --no-install-recommends \
    libc6 \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies first (for better caching)
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Command to run tests
CMD ["npm", "test"]
