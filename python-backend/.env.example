# Server configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# File upload configuration
MAX_UPLOAD_SIZE=50000000
UPLOAD_FOLDER=uploads
UPLOAD_PATH=/api/pdf/upload

# ChromaDB configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PROTOCOL=http

# API keys (optional)
OPENAI_API_KEY=your-openai-api-key
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=your-openrouter-api-key

# Frontend URL
APP_URL=http://localhost:8080

# Optional settings
DEBUG_UPLOAD=false

# Environment Configuration

# Node environment (development, production)
NODE_ENV=development

# Port for the API server
PORT=3000

# Log level (debug, info, warning, error, critical)
LOG_LEVEL=info

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# OpenRouter API Key (optional, for fallback LLM service)
OPENROUTER_API_KEY=your-openrouter-api-key

# Frontend URL for redirects
FRONTEND_URL=http://localhost:8080

# Database connection (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./podai.db

# JWT Secret Key for authentication tokens
JWT_SECRET_KEY=change-this-to-a-secure-secret-in-production

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Super admin user configuration
SUDO_EMAIL=admin@example.com
SUDO_USERNAME=Administrator
SUDO_PASSWORD=change-this-to-a-secure-password